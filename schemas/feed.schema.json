{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnaus.org/schemas/feed.schema.json",
  "title": "CNAUS Feed (Informative Schema)",
  "type": "object",
  "required": ["version", "feed_generated_at", "events"],
  "properties": {
    "version": { "type": "string" },
    "feed_generated_at": { "type": "string" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event_id", "event_type", "registry_id", "version", "proof_hash", "timestamp", "prev_hash", "details"],
        "properties": {
          "event_id": { "type": "string" },
          "event_type": { "type": "string" },
          "registry_id": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] },
          "proof_hash": { "type": ["string", "null"] },
          "timestamp": { "type": "string" },
          "prev_hash": { "type": ["string", "null"] },
          "details": { "type": "object" }
        }
      }
    }
  }
}
